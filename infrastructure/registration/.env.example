# Copy to .env (chmod 600). Never commit the real .env.

# --- provisioning broker -----------------------------------------------------
# The app never holds the mailcow API key; it asks the broker (see
# broker.env.example). Same token as SIGNUP_TOKEN there: openssl rand -hex 32
BROKER_URL=http://broker:8100
BROKER_TOKEN=

# --- service ------------------------------------------------------------------
# Must match MAIL_DOMAIN in broker.env.
MAIL_DOMAIN=avedeus.ovh
BRAND_NAME=Avedeus Mail
PUBLIC_URL=https://mail.avedeus.ovh
WEBMAIL_URL=https://mail.avedeus.ovh
BASE_PATH=/join
DATABASE_PATH=/data/registration.sqlite3
# Only nginx-mailcow's address on avedeus-edge may set the client IP.
FORWARDED_ALLOW_IPS=172.30.240.2

# --- secrets ------------------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=

# --- admin console (PR 15) ----------------------------------------------------
# The admin pages moved to the admin console (admin/, at /console) and need
# Keycloak. Its token for this app's internal invitation API: same value as
# SIGNUP_CONSOLE_TOKEN in admin.env (openssl rand -hex 32). Empty = the
# internal API is off; invitations then come from the CLI:
#   docker compose exec registration python -m app.cli create-invite --note "Sam"
# ADMIN_CONSOLE_TOKEN=
# Only this address may call it (the console's fixed address on avedeus-edge).
# ADMIN_CONSOLE_CLIENTS=172.30.240.14

# --- defaults (optional) ------------------------------------------------------
DEFAULT_QUOTA_MB=2048
MAX_QUOTA_MB=10240
INVITE_DAYS=7
MIN_USERNAME_LEN=3
MIN_PASSWORD_LEN=12
# EXTRA_RESERVED_USERNAMES=team,office
# RL_REGISTER_PER_HOUR=10
# RL_INVITE_CHECK_PER_HOUR=30
# Event log rows (they hold client IPs) are deleted after this many days; 0 = keep.
# EVENT_RETENTION_DAYS=180
