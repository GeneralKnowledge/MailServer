# Copy to .env (chmod 600). Never commit the real .env.

# --- mailcow API --------------------------------------------------------------
# Talk to mailcow's nginx over the internal Docker network, verifying the
# certificate for the public hostname.
MAILCOW_API_URL=https://nginx-mailcow
MAILCOW_TLS_HOSTNAME=mail.example.com
MAILCOW_VERIFY_TLS=true
# Read-write API key from mailcow: System > Configuration > Access > API,
# "Allow API access from these IPs" = 172.22.1.240 (this container only).
MAILCOW_API_KEY=

# --- service ------------------------------------------------------------------
MAIL_DOMAIN=example.com
BRAND_NAME=Private Mail
PUBLIC_URL=https://mail.example.com
WEBMAIL_URL=https://mail.example.com
BASE_PATH=/join
DATABASE_PATH=/data/registration.sqlite3
FORWARDED_ALLOW_IPS=172.22.1.0/24

# --- secrets ------------------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=
ADMIN_USERNAME=admin
# docker compose run --rm registration python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# docker compose run --rm registration python -m app.cli new-totp
ADMIN_TOTP_SECRET=

# --- defaults (optional) ------------------------------------------------------
DEFAULT_QUOTA_MB=2048
MAX_QUOTA_MB=10240
INVITE_DAYS=7
MIN_USERNAME_LEN=3
MIN_PASSWORD_LEN=12
# EXTRA_RESERVED_USERNAMES=team,office
# RL_REGISTER_PER_HOUR=10
# RL_INVITE_CHECK_PER_HOUR=30
# RL_LOGIN_PER_15MIN=5
