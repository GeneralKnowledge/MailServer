# Copy to .env (chmod 600). Never commit the real .env.

# --- mailcow API --------------------------------------------------------------
# Talk to mailcow's nginx over the avedeus-edge network, verifying the
# certificate for the public hostname.
MAILCOW_API_URL=https://nginx-mailcow
MAILCOW_TLS_HOSTNAME=mail.avedeus.ovh
MAILCOW_VERIFY_TLS=true
# Read-write API key from mailcow: System > Configuration > Access > API,
# "Allow API access from these IPs" = 172.30.240.10 (this container only).
MAILCOW_API_KEY=

# --- service ------------------------------------------------------------------
MAIL_DOMAIN=avedeus.ovh
BRAND_NAME=Avedeus Mail
PUBLIC_URL=https://mail.avedeus.ovh
WEBMAIL_URL=https://mail.avedeus.ovh
BASE_PATH=/join
DATABASE_PATH=/data/registration.sqlite3
# Only nginx-mailcow's address on avedeus-edge may set the client IP.
FORWARDED_ALLOW_IPS=172.30.240.2

# --- secrets ------------------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=
ADMIN_USERNAME=admin
# docker compose run --rm registration python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# docker compose run --rm registration python -m app.cli new-totp
ADMIN_TOTP_SECRET=
# Only these addresses can open /join/admin (others get 404). Comma-separated
# IPs/CIDRs, e.g. your home IP or VPN range. Required: the app won't start
# without it unless ADMIN_ALLOW_ANY=1 (then anyone can try to sign in, and
# can trip the all-IPs login limit to lock you out for an hour; the CLI over
# SSH still works then).
ADMIN_ALLOWED_IPS=
# ADMIN_ALLOW_ANY=1

# --- defaults (optional) ------------------------------------------------------
DEFAULT_QUOTA_MB=2048
MAX_QUOTA_MB=10240
INVITE_DAYS=7
MIN_USERNAME_LEN=3
MIN_PASSWORD_LEN=12
# EXTRA_RESERVED_USERNAMES=team,office
# RL_REGISTER_PER_HOUR=10
# RL_INVITE_CHECK_PER_HOUR=30
# RL_LOGIN_PER_15MIN=5
# RL_LOGIN_GLOBAL_PER_HOUR=30
# Event log rows (they hold client IPs) are deleted after this many days; 0 = keep.
# EVENT_RETENTION_DAYS=180
