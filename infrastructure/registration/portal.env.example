# Copy to infrastructure/registration/portal.env (chmod 600). Portal (PR 14):
# only after Keycloak is deployed (ADR 0006 gate). Started with
#   docker compose --profile identity up -d portal
PUBLIC_URL=https://mx.example.com
OIDC_ISSUER=https://mx.example.com/auth/realms/avedeus
# Same value as PORTAL_OIDC_SECRET in infrastructure/identity/identity.env.
OIDC_CLIENT_SECRET=
# The portal's own control-plane credential: same value as PORTAL_TOKEN in
# broker.env (which also sets PORTAL_CLIENTS=172.30.240.13): openssl rand -hex 32
PORTAL_TOKEN=
# Signs the login-handshake cookie: openssl rand -hex 32
SESSION_SECRET=
BRAND_NAME=Avedeus Mail
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
# CONTROL_PLANE_URL=http://broker:8100
