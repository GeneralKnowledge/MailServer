# Copy to infrastructure/registration/admin.env (chmod 600). Admin console
# (PR 15, ADR 0020): only after Keycloak is deployed (ADR 0006 gate). Started with
#   docker compose --profile identity up -d admin-console
# and reached at https://<mail host>/console/ from an address allowed in
# site.identity.custom and below.
PUBLIC_URL=https://mx.example.com
OIDC_ISSUER=https://mx.example.com/auth/realms/avedeus
# Same value as ADMIN_OIDC_SECRET in infrastructure/identity/identity.env.
OIDC_CLIENT_SECRET=
# The console's control-plane credential: same value as ADMIN_TOKEN in
# broker.env (whose ADMIN_CLIENTS must include 172.30.240.14): openssl rand -hex 32
CONTROL_PLANE_TOKEN=
# Its credential for the sign-up app's internal invitation API: same value as
# ADMIN_CONSOLE_TOKEN in .env. Must differ from CONTROL_PLANE_TOKEN.
SIGNUP_CONSOLE_TOKEN=
# Signs the login-handshake cookie: openssl rand -hex 32
SESSION_SECRET=
# Only these addresses reach the console (others get 404). Comma-separated
# IPs/CIDRs. Required unless ADMIN_ALLOW_ANY=1. nginx limits /console/ too.
ADMIN_ALLOWED_IPS=
BRAND_NAME=Avedeus Mail
# ADMIN_GROUP=admins
# REQUIRE_OTP=true      # the console and the control plane both want "otp" in the token's amr
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
# CONTROL_PLANE_URL=http://broker:8100
# SIGNUP_URL=http://registration:8000
