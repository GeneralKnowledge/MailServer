# Copy to infrastructure/registration/broker.env (chmod 600). Never commit the real file.
# Only the broker container reads this file; the registration app never sees the API key.

# --- mailcow API --------------------------------------------------------------
MAILCOW_API_URL=https://nginx-mailcow
MAILCOW_TLS_HOSTNAME=mail.avedeus.ovh
MAILCOW_VERIFY_TLS=true
# Read-write key from mailcow (API_KEY in mailcow.conf), allowed only from
# 172.30.240.11 (API_ALLOW_FROM), the broker's address on avedeus-edge.
MAILCOW_API_KEY=

# --- rules the broker enforces ------------------------------------------------
MAIL_DOMAIN=avedeus.ovh
MAX_QUOTA_MB=10240
MIN_USERNAME_LEN=3
# More new mailboxes than this in 24 h are refused (and logged).
MAX_CREATES_PER_DAY=20
# EXTRA_RESERVED_USERNAMES=team,office

# --- who may call it (one credential per caller) ---------------------------------
# What each caller may do is fixed in code (broker/broker/capabilities.py,
# mirroring contracts/capabilities.yaml). Every token must be different.
#
# signup: the registration app. Same value as BROKER_TOKEN in the
# registration .env: openssl rand -hex 32
SIGNUP_TOKEN=
SIGNUP_CLIENTS=172.30.240.10
#
# monitoring (optional): may read /v1/health and /v1/upstream only. Nothing
# uses it yet; leave both empty to turn the caller off.
# MONITORING_TOKEN=
# MONITORING_CLIENTS=

# --- its own database -----------------------------------------------------------
# Audit log and idempotency records, in the control-plane-data volume.
# CONTROL_PLANE_DB=/data/control-plane.sqlite3
