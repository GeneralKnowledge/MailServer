# Copy to infrastructure/registration/broker.env (chmod 600). Never commit the real file.
# Only the broker container reads this file; the registration app never sees the API key.

# --- mailcow API --------------------------------------------------------------
MAILCOW_API_URL=https://nginx-mailcow
MAILCOW_TLS_HOSTNAME=mail.avedeus.ovh
MAILCOW_VERIFY_TLS=true
# Read-write key from mailcow (API_KEY in mailcow.conf), allowed only from
# 172.30.240.11 (API_ALLOW_FROM), the broker's address on avedeus-edge.
MAILCOW_API_KEY=

# --- rules the broker enforces ------------------------------------------------
MAIL_DOMAIN=avedeus.ovh
MAX_QUOTA_MB=10240
MIN_USERNAME_LEN=3
# More new mailboxes than this in 24 h are refused (and logged).
MAX_CREATES_PER_DAY=20
# EXTRA_RESERVED_USERNAMES=team,office

# --- who may call it (one credential per caller) ---------------------------------
# What each caller may do is fixed in code (broker/broker/capabilities.py,
# mirroring contracts/capabilities.yaml). Every token must be different.
#
# signup: the registration app. Same value as BROKER_TOKEN in the
# registration .env: openssl rand -hex 32
SIGNUP_TOKEN=
SIGNUP_CLIENTS=172.30.240.10
#
# monitoring: may read /v1/health and /v1/upstream only. scripts/health-check.sh
# runs `python -m broker.probe` inside this container, which calls /v1/health
# from 127.0.0.1 with this token. A different value: openssl rand -hex 32
MONITORING_TOKEN=
MONITORING_CLIENTS=127.0.0.1
#
# admin (PR 34, PR 15): the message trace, accounts list and audit log. From
# the admin console (172.30.240.14) every call must also carry the admin's own
# Keycloak token (client avedeus-admin, group admins, signed in with a
# one-time code). From 127.0.0.1 (`python -m broker.trace` inside this
# container) the token alone is enough: break-glass, audited as such (ADR 0020).
# Same value as CONTROL_PLANE_TOKEN in admin.env: openssl rand -hex 32
# ADMIN_TOKEN=
# ADMIN_CLIENTS=127.0.0.1,172.30.240.14
# ADMIN_CLIENT_ID=avedeus-admin
# ADMIN_GROUP=admins
# ADMIN_REQUIRE_OTP=true
#
# portal (PR 14): the account portal at /account; only with IDENTITY_PROVIDER=keycloak.
# Same value as PORTAL_TOKEN in portal.env: openssl rand -hex 32
# PORTAL_TOKEN=
# PORTAL_CLIENTS=172.30.240.13
# The public issuer the portal's and the admin console's tokens must come from:
# KEYCLOAK_ISSUER=https://mx.example.com/auth/realms/avedeus

# --- its own database -----------------------------------------------------------
# Audit log and idempotency records, in the control-plane-data volume.
# CONTROL_PLANE_DB=/data/control-plane.sqlite3

# --- one identity (PR 12) ---------------------------------------------------------
# none (default): accounts use mailcow's own login, as before.
# keycloak: createAccount makes the Keycloak user first, then the mailbox with
# Keycloak as its login source; mail apps then use mailcow app passwords
# (ADR 0015). Only after the ADR 0006 gate has passed and Keycloak is deployed
# (docs/identity.md). Setting it back to none is the removal path.
# IDENTITY_PROVIDER=none
# KEYCLOAK_URL=http://keycloak:8080/auth        # direct on avedeus-edge, not through nginx
# KEYCLOAK_REALM=avedeus
# KEYCLOAK_CLIENT_ID=avedeus-control-plane
# Same value as CONTROL_PLANE_OIDC_SECRET in infrastructure/identity/identity.env.
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_GROUP=users
# mailcow mailbox template to record on each new user (mailcow_template
# attribute), so mailcow's sync applies the same template. Empty = none.
# MAILBOX_TEMPLATE=avedeus-user

# --- message trace (PR 34) ------------------------------------------------------
# mailcow's READ-ONLY API key (Access -> API -> Read-only access), allowed from
# 172.30.240.11 only. The trace uses only this key, so it cannot write.
# MAILCOW_READ_ONLY_API_KEY=
# How many of the newest lines of each mailcow log to search.
# TRACE_LOG_LINES=10000
