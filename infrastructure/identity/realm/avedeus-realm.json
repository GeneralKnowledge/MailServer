{
  "realm": "avedeus",
  "displayName": "Avedeus",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(3)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "groups": [
    {
      "name": "users",
      "path": "/users"
    },
    {
      "name": "admins",
      "path": "/admins"
    }
  ],
  "clients": [
    {
      "clientId": "mailcow",
      "name": "mailcow (webmail and user settings)",
      "description": "mailcow's identity provider client (PR 12). Browser sign-in only: mail clients use mailcow app passwords (ADR 0015). Its service account may read users for mailcow's user sync.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MAILCOW_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "rootUrl": "https://${MAIL_HOSTNAME}",
      "redirectUris": [
        "https://${MAIL_HOSTNAME}/*"
      ],
      "webOrigins": [
        "https://${MAIL_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${MAIL_HOSTNAME}/*"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "profile",
        "email",
        "web-origins",
        "kc-admin-api"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "avedeus-control-plane",
      "name": "Avedeus control plane",
      "description": "The control plane's Keycloak adapter (PR 12): creates invited users and puts them in groups. No browser flows.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CONTROL_PLANE_OIDC_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "kc-admin-api"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "avedeus-portal",
      "name": "Avedeus portal (/account)",
      "description": "The account portal (PR 14): browser sign-in with code + PKCE. Its tokens are verified by the control plane.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PORTAL_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "rootUrl": "https://${MAIL_HOSTNAME}/account/",
      "redirectUris": [
        "https://${MAIL_HOSTNAME}/account/callback"
      ],
      "webOrigins": [
        "https://${MAIL_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${MAIL_HOSTNAME}/account/"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "avedeus-admin",
      "name": "Avedeus admin console (/console)",
      "description": "The admin console (PR 15, ADR 0020): browser sign-in with code + PKCE, always password and one-time code. Its tokens carry groups and amr, and the control plane verifies them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ADMIN_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "rootUrl": "https://${MAIL_HOSTNAME}/console/",
      "redirectUris": [
        "https://${MAIL_HOSTNAME}/console/callback"
      ],
      "webOrigins": [
        "https://${MAIL_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${MAIL_HOSTNAME}/console/",
        "access.token.lifespan": "300"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "a7ede115-0000-4000-8000-00000000c015"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-mailcow",
      "enabled": true,
      "serviceAccountClientId": "mailcow",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    },
    {
      "username": "service-account-avedeus-control-plane",
      "enabled": true,
      "serviceAccountClientId": "avedeus-control-plane",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "mailcow",
        "roles": [
          "view-users",
          "query-users",
          "query-groups"
        ]
      },
      {
        "client": "avedeus-control-plane",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"mailcow_template\",\"displayName\":\"mailcow mailbox template\",\"validations\":{\"length\":{\"max\":64}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"annotations\":{},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "authenticatorConfig": [
    {
      "alias": "admin-console-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "admin-console-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "0"
      }
    }
  ],
  "authenticationFlows": [
    {
      "id": "a7ede115-0000-4000-8000-00000000c015",
      "alias": "admin console browser",
      "description": "PR 15: the admin console's own browser flow. No SSO cookie shortcut, no identity providers: password and one-time code at every sign-in (a user without one sets it up first).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "admin-console-pwd"
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorConfig": "admin-console-otp"
        }
      ]
    }
  ]
}
