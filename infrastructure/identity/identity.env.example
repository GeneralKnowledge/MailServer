# Copy to identity.env (chmod 600). Not deployed until the ADR 0006 gate passes.
# Generate secrets with: openssl rand -hex 32

# Public URL of Keycloak, through mailcow's nginx (same host as mailcow).
KC_HOSTNAME=https://mx.example.com/auth

# Database (Postgres reads POSTGRES_PASSWORD; Keycloak reads KC_DB_PASSWORD).
POSTGRES_PASSWORD=change-me-same-as-below
KC_DB_PASSWORD=change-me-same-as-above

# Temporary admin for the first start only. Sign in once from an allowed
# address, create a named admin with TOTP in the master realm, then delete
# this user and remove these two lines (docs/identity.md).
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Values substituted into realm/avedeus-realm.json on first import.
MAIL_HOSTNAME=mx.example.com
MAILCOW_OIDC_SECRET=change-me
CONTROL_PLANE_OIDC_SECRET=change-me
PORTAL_OIDC_SECRET=change-me
# PR 15: the admin console's client (avedeus-admin): openssl rand -hex 32
ADMIN_OIDC_SECRET=change-me
# PR 17: Keycloak sends "Forgot password" links through mailcow's own
# submission port (587, STARTTLS, the real certificate) as this mailbox, with
# an app password made for it in mailcow (docs/identity.md).
KEYCLOAK_SMTP_USER=noreply@mail.example.com
KEYCLOAK_SMTP_PASSWORD=change-me
