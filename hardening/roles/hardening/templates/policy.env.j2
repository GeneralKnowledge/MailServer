# {{ ansible_managed }}
# What this host is meant to expose. hardening-audit compares the live host
# with it; change it through the inventory, not here.
SSH_TAILSCALE_ONLY={{ hardening_ssh_tailscale_only | ternary(1, 0) }}
SSH_ALLOW_FROM="{{ hardening_ssh_allow_from | join(' ') }}"
PUBLIC_TCP="22 {{ (hardening_public_tcp_ports + hardening_docker_public_tcp_ports) | unique | join(' ') }}"
PUBLIC_UDP="{{ (hardening_public_udp_ports + hardening_docker_public_udp_ports + (hardening_tailscale | ternary([41641], []))) | unique | join(' ') }}"
DOCKER_GUARD={{ hardening_docker_guard | ternary(1, 0) }}
FAIL2BAN={{ hardening_fail2ban | ternary(1, 0) }}
LOGIN_ALERTS={{ hardening_login_alerts | ternary(1, 0) }}
DIGEST={{ hardening_digest | ternary(1, 0) }}
